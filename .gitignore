# 运行环境
/.venv/
/.venv_flash/
__pycache__/
*.py[cod]
*$py.class

# 本机状态：配置（含密码哈希/域名/资源库清单）、浏览器 profile、缓存、日志，全部在 var/ 下，
# 路径见 omni/core/paths.py。整个目录可以拷走迁移，但绝不进库。
/var/

# v2 的旧状态位置——启动时由 omni/core/migrate.py 自动搬进 var/，这里只防止残留被误提交
/cache/
/data/
/config/
/cookies.txt
/services/local_settings.py

# 下载中心调用的个人爬虫脚本（含站点 cookie/账号相关逻辑），按个人工具处理，不进库
/tools/crawlers/

# 游戏与媒体资源一律不在仓库里——资源库位置在 var/config/settings.json，见 omni/core/library.py
*.cbz
*.cbr
*.epub

*.log
.ropeproject/
.DS_Store
Thumbs.db
*.swp
*.swo
